# Supabase Configuration (Free tier PostgreSQL, Auth, and Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Service Configuration (Optional: Deterministic fallback engine is used if not set)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-or-openai-api-key

# Application Base URL (Used for WhatsApp deep links and family invitations)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Integration (Optional: Generates standard WhatsApp web/app deep links without API key)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TOKEN=
