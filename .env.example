# =======================================================
# Matrimony OS — Environment Configuration Template
# =======================================================

# 1. Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3010

# 2. Supabase Database & Auth Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Email Delivery (Resend API)
# Used for dispatching contact form messages and notifications to matrimony@flugelsoft.com
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL_TO=matrimony@flugelsoft.com

# 4. AI Matchmaking & Bio Polish Configuration
# Options: 'deterministic' (zero API cost, built-in) or 'openai' / 'anthropic' / 'gemini'
AI_PROVIDER=deterministic
AI_API_KEY=
